
---
const pageTitle = "Portfolio Controls";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
  </head>

  <body>
    <main class="dashboard">

      <!-- Header -->
      <header class="topbar">
        <div>
          <h1>Portfolio Controls</h1>
          <p>Manage your portfolio website from one place.</p>
        </div>

        <a href="/admin" class="logout">Logout</a>
      </header>

      <!-- Welcome -->
      <section class="welcome">
        <div>
          <h2>Welcome to Admin Panel</h2>
          <p>Choose what you want to manage.</p>
        </div>

        <span class="status">Website Controls</span>
      </section>

      <!-- Manage Website -->
      <section class="controls">
        <h2>Manage Website</h2>

        <div class="control-grid">

          <button class="control-card" data-modal="contact">
            <span class="number">01</span>
            <h3>Contact Details</h3>
            <p>Update email, phone number and social links.</p>
            <span class="action">Manage Details →</span>
          </button>

          <button class="control-card" data-modal="resume">
            <span class="number">02</span>
            <h3>Resume</h3>
            <p>Upload or replace your portfolio resume.</p>
            <span class="action">Manage Resume →</span>
          </button>

          <button class="control-card" data-modal="theme">
            <span class="number">03</span>
            <h3>Website Colors</h3>
            <p>Change primary and secondary website colors.</p>
            <span class="action">Customize Colors →</span>
          </button>

        </div>
      </section>

      <!-- Quick Information -->
      <section class="info">
        <h2>Quick Information</h2>
        <p>
          Manage your portfolio settings from this panel.
          Backend integration will enable permanent saving.
        </p>
      </section>

      <footer>
        Portfolio Admin Panel · Gaurav Doliya
      </footer>

    </main>

    <!-- Modal -->
    <div class="modal-overlay" id="adminModal">
      <div class="modal-box">

        <div class="modal-header">
          <h2 id="modalTitle">Settings</h2>
          <button type="button" id="closeModal" aria-label="Close">×</button>
        </div>

        <div id="modalContent"></div>

      </div>
    </div>

  </body>
</html>

<script>
  const modal = document.querySelector("#adminModal");
  const modalTitle = document.querySelector("#modalTitle");
  const modalContent = document.querySelector("#modalContent");
  const closeModal = document.querySelector("#closeModal");

  const modalData = {
    contact: {
      title: "Contact Details",
      content: `
        <form id="contactForm">

          <label for="email">Email Address</label>
          <input type="email" id="email" placeholder="Enter email address" required>

          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" placeholder="Enter phone number">

          <label for="linkedin">LinkedIn URL</label>
          <input type="url" id="linkedin" placeholder="Enter LinkedIn URL">

         

          <label for="location">Location</label>
          <input type="text" id="location" placeholder="Enter location">

          <button type="submit" class="save-button">Save Changes</button>

          <p class="form-message" id="contactMessage"></p>

        </form>
      `
    },

    resume: {
      title: "Resume Management",
      content: `
        <div class="current-resume">
          <div class="file-icon">PDF</div>

          <div>
            <h3>Gaurav Doliya Resume</h3>
            <p>CV_Gaurav_Doliya.pdf</p>
            <a href="/CV_Gaurav_Doliya.pdf" target="_blank">
              View Current Resume ↗
            </a>
          </div>
        </div>

        <form id="resumeForm">

          <label for="resumeFile">Upload New Resume</label>

          <div class="upload-box">
            <input
              type="file"
              id="resumeFile"
              accept=".pdf,application/pdf"
              required
            />
            <p>Only PDF files are allowed.</p>
          </div>

          <button type="submit" class="save-button">
            Update Resume
          </button>

          <p class="form-message" id="resumeMessage"></p>

        </form>
      `
    },

    theme: {
      title: "Website Colors",
      content: `
        <form id="themeForm">

          <label for="primaryColor">Primary Color</label>
          <div class="color-input">
            <input type="color" id="primaryColor" value="#a78bfa">
            <span>Primary accent color</span>
          </div>

          <label for="backgroundColor">Background Color</label>
          <div class="color-input">
            <input type="color" id="backgroundColor" value="#101014">
            <span>Website background color</span>
          </div>

          <label for="textColor">Text Color</label>
          <div class="color-input">
            <input type="color" id="textColor" value="#ffffff">
            <span>Website text color</span>
          </div>

          <button type="submit" class="save-button">
            Save Colors
          </button>

          <p class="form-message" id="themeMessage"></p>

        </form>
      `
    }
  };

  let latestResumeUrl = "/CV_Gaurav_Doliya.pdf";
  let latestResumeName = "CV_Gaurav_Doliya.pdf";

  // Open modal
  document.querySelectorAll("[data-modal]").forEach((card) => {
    card.addEventListener("click", () => {
      const type = card.getAttribute("data-modal");

      if (!type || !modal || !modalTitle || !modalContent) return;

      const data = modalData[type as keyof typeof modalData];

      if (!data) return;

      modalTitle.textContent = data.title;
      modalContent.innerHTML = data.content;

      if (type === "resume") {
        const link = modalContent.querySelector(".current-resume a");
        const name = modalContent.querySelector(".current-resume p");
        if (link && latestResumeUrl) {
          link.setAttribute("href", latestResumeUrl);
        }
        if (name && latestResumeName) {
          name.textContent = latestResumeName;
        }
      }

      modal.classList.add("active");
      document.body.classList.add("modal-open");

      attachFormEvents();
    });
  });

  // Close modal
  function hideModal() {
    modal?.classList.remove("active");
    document.body.classList.remove("modal-open");
  }

  closeModal?.addEventListener("click", hideModal);

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      hideModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      hideModal();
    }
  });

  // Form events
  function attachFormEvents() {

    // Contact form
    const contactForm = document.querySelector("#contactForm");

    contactForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      const message = document.querySelector("#contactMessage");

      if (message) {
        message.textContent =
          "Contact details form is ready. Backend saving will be connected later.";
      }
    });

    // Resume form
    const resumeForm = document.querySelector("#resumeForm");

    resumeForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const fileInput = document.querySelector("#resumeFile") as HTMLInputElement | null;
      const message = document.querySelector("#resumeMessage") as HTMLElement | null;
      const submitButton = resumeForm.querySelector("button[type='submit']") as HTMLButtonElement | null;
      const currentResumeLink = document.querySelector(".current-resume a") as HTMLAnchorElement | null;
      const currentResumeName = document.querySelector(".current-resume p") as HTMLElement | null;

      const file = fileInput?.files?.[0];

      if (!file || !message) return;

      // Validate that only PDF files are selected
      const isPdf = file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf");
      if (!isPdf) {
        message.textContent = "Please select a valid PDF file.";
        message.style.color = "#f87171";
        return;
      }

      // Show uploading state and prevent multiple submissions
      const originalButtonText = submitButton ? submitButton.textContent : "Update Resume";
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Uploading...";
        submitButton.style.opacity = "0.7";
        submitButton.style.cursor = "not-allowed";
      }

      message.textContent = "Uploading resume, please wait...";
      message.style.color = "#c4b5fd";

      try {
        const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";

        // Send PDF using FormData with exact key "resume"
        const formData = new FormData();
        formData.append("resume", file);

        // Do not manually set Content-Type header
        const response = await fetch(`${apiUrl}/api/resume/upload`, {
          method: "POST",
          body: formData
        });

        const data = await response.json().catch(() => null);

        // Display success and error messages based on API response
        if (response.ok && data?.success) {
          message.textContent = data.message || "Resume uploaded successfully!";
          message.style.color = "#4ade80";

          // Update current resume preview/download link
          const uploadedUrl = `${apiUrl}/uploads/resume.pdf`;
          latestResumeUrl = uploadedUrl;
          latestResumeName = file.name;

          if (currentResumeLink) {
            currentResumeLink.setAttribute("href", uploadedUrl);
            currentResumeLink.textContent = "View Current Resume ↗";
          }
          if (currentResumeName) {
            currentResumeName.textContent = file.name;
          }

          if (fileInput) {
            fileInput.value = "";
          }
        } else {
          message.textContent = data?.message || "Failed to upload resume. Please try again.";
          message.style.color = "#f87171";
        }
      } catch (error) {
        // Handle network errors properly
        console.error("Resume upload network error:", error);
        message.textContent = "Network error: Unable to connect to backend server (http://localhost:3000). Please ensure your backend is running.";
        message.style.color = "#f87171";
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalButtonText || "Update Resume";
          submitButton.style.opacity = "1";
          submitButton.style.cursor = "pointer";
        }
      }
    });

    // Theme form
    const themeForm = document.querySelector("#themeForm");

    themeForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      const message = document.querySelector("#themeMessage");

      if (message) {
        message.textContent =
          "Colors selected successfully. Permanent saving will be connected later.";
      }
    });
  }
</script>

<style>
  * {
    box-sizing: border-box;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: #101014;
    color: #fff;
    font-family: Arial, sans-serif;
  }

  body.modal-open {
    overflow: hidden;
  }

  .dashboard {
    width: min(100% - 40px, 1100px);
    margin: 0 auto;
    padding: 45px 0;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 35px;
  }

  h1, h2, h3, p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 8px;
    font-size: 28px;
  }

  .topbar p,
  .welcome p {
    color: #999;
    font-size: 14px;
    margin-bottom: 0;
  }

  .logout {
    color: #c4b5fd;
    text-decoration: none;
    border: 1px solid #393342;
    padding: 10px 18px;
    border-radius: 7px;
    font-size: 13px;
  }

  .welcome {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 28px;
    background: #1c1923;
    border: 1px solid #342c40;
    border-radius: 12px;
    margin-bottom: 40px;
  }

  .welcome h2 {
    margin-bottom: 8px;
    font-size: 21px;
  }

  .status {
    color: #c4b5fd;
    background: #302541;
    padding: 9px 13px;
    border-radius: 20px;
    font-size: 11px;
    white-space: nowrap;
  }

  .controls h2,
  .info h2 {
    font-size: 18px;
    margin-bottom: 20px;
  }

  .control-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .control-card {
    display: block;
    width: 100%;
    padding: 25px;
    border: 1px solid #302d36;
    border-radius: 12px;
    background: #19181d;
    color: white;
    text-align: left;
    font-family: inherit;
    cursor: pointer;
    transition: 0.2s;
  }

  .control-card:hover {
    border-color: #a78bfa;
    transform: translateY(-3px);
  }

  .number {
    color: #a78bfa;
    font-size: 12px;
  }

  .control-card h3 {
    margin: 24px 0 10px;
    font-size: 17px;
  }

  .control-card p {
    color: #999;
    font-size: 13px;
    line-height: 1.7;
    min-height: 44px;
  }

  .action {
    display: inline-block;
    margin-top: 12px;
    color: #c4b5fd;
    font-size: 12px;
    font-weight: 600;
  }

  .info {
    margin-top: 35px;
    padding: 24px;
    border: 1px solid #302d36;
    border-radius: 10px;
  }

  .info p {
    color: #999;
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 0;
  }

  footer {
    margin-top: 45px;
    color: #777;
    font-size: 12px;
    text-align: center;
  }

  /* Modal */

  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(5px);
  }

  .modal-overlay.active {
    display: flex;
  }

  .modal-box {
    width: 100%;
    max-width: 500px;
    max-height: 85vh;
    overflow-y: auto;
    padding: 28px;
    background: #19181d;
    border: 1px solid #393342;
    border-radius: 12px;
    animation: modalOpen 0.2s ease;
  }

  @keyframes modalOpen {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 20px;
  }

  #closeModal {
    border: 0;
    background: transparent;
    color: white;
    font-size: 27px;
    cursor: pointer;
  }

  .modal-box label {
    display: block;
    margin: 18px 0 8px;
    color: #ddd;
    font-size: 13px;
    font-weight: 600;
  }

  .modal-box input:not([type="color"]):not([type="file"]) {
    width: 100%;
    height: 44px;
    padding: 10px 12px;
    border: 1px solid #393342;
    border-radius: 7px;
    background: #101014;
    color: white;
    outline: none;
  }

  .modal-box input:focus {
    border-color: #a78bfa;
  }

  .modal-box input[type="file"] {
    display: block;
    max-width: 100%;
    color: #ccc;
  }

  .save-button {
    width: 100%;
    margin-top: 23px;
    padding: 13px;
    border: 0;
    border-radius: 7px;
    background: #a78bfa;
    color: #17121f;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
  }

  .save-button:hover {
    background: #b9a4ff;
  }

  .form-message {
    color: #c4b5fd;
    font-size: 12px;
    margin-top: 14px;
  }

  /* Resume */

  .current-resume {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px;
    margin-bottom: 25px;
    border: 1px solid #302d36;
    border-radius: 9px;
    background: #111014;
  }

  .file-icon {
    padding: 14px 12px;
    background: #3c2026;
    color: #ff9ba5;
    border-radius: 8px;
    font-weight: bold;
    font-size: 12px;
  }

  .current-resume h3 {
    margin-bottom: 7px;
    font-size: 14px;
  }

  .current-resume p {
    color: #999;
    font-size: 12px;
    margin-bottom: 8px;
  }

  .current-resume a {
    color: #c4b5fd;
    font-size: 12px;
    text-decoration: none;
  }

  .upload-box {
    padding: 18px;
    border: 1px dashed #51485f;
    border-radius: 9px;
  }

  .upload-box p {
    color: #888;
    font-size: 12px;
    margin: 12px 0 0;
  }

  /* Theme */

  .color-input {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border: 1px solid #393342;
    border-radius: 8px;
    background: #111014;
  }

  .color-input input {
    width: 45px;
    height: 38px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .color-input span {
    color: #aaa;
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .control-grid {
      grid-template-columns: 1fr;
    }

    .welcome {
      align-items: flex-start;
      flex-direction: column;
    }

    .topbar {
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .dashboard {
      padding: 30px 0;
    }

    .modal-box {
      padding: 22px;
    }
  }
</style>
    