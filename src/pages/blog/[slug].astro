---
// src/pages/blog/[slug].astro
import { blogs, type BlogPost } from "../../data/blogs";
import Navbar from "../../components/Navbar.astro";
import "../../styles/global.css";

export function getStaticPaths() {
  return blogs.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const currentIndex = blogs.findIndex((b) => b.slug === post.slug);
const prevPost = currentIndex > 0 ? blogs[currentIndex - 1] : null;
const nextPost = currentIndex < blogs.length - 1 ? blogs[currentIndex + 1] : null;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>{post.title} | Gaurav Doliya</title>
    <meta name="description" content={post.excerpt} />

    <!-- Google Fonts: Anton & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Default to dark theme -->
    <script is:inline>
      (() => {
        const isDark = (() => {
          if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('theme')) {
            return sessionStorage.getItem('theme') === 'dark';
          }
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme') === 'dark';
          }
          return true;
        })();
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>

  <body
    class="min-h-screen bg-[#F5F5F5] text-zinc-900 dark:bg-black dark:text-zinc-100 selection:bg-[#7C3AED] selection:text-white transition-colors duration-200"
  >
    <Navbar />

    <main class="py-12 sm:py-16 md:py-20">
      <article class="mx-auto max-w-4xl px-6 sm:px-8">
        
        <!-- Back Navigation Button -->
        <div class="mb-10">
          <a
            href="/blogs"
            class="group inline-flex items-center gap-2 rounded-md border border-zinc-300 bg-white px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-zinc-900 shadow-sm transition-all hover:border-[#7C3AED] hover:bg-[#7C3AED] hover:text-white dark:border-zinc-800 dark:bg-zinc-950 dark:text-white dark:hover:border-[#7C3AED] dark:hover:bg-[#7C3AED]"
          >
            <svg
              class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Back to All Articles</span>
          </a>
        </div>

        <!-- Article Header -->
        <header class="pb-8">
          
          <!-- Category & Date Meta with Square Bullet Accent -->
          <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
            <span class="text-[#7C3AED] font-extrabold uppercase tracking-wider">
              {post.category}
            </span>
            <span class="h-1.5 w-1.5 bg-[#7C3AED]"></span>
            <span class="text-zinc-500 dark:text-zinc-400 font-bold uppercase tracking-wider">
              {post.date}
            </span>
            <span class="h-1.5 w-1.5 bg-[#7C3AED]"></span>
            <span class="text-zinc-500 dark:text-zinc-400 font-bold uppercase tracking-wider">
              {post.readTime}
            </span>
          </div>

          <!-- Main Article Title -->
          <h1 class="mt-4 text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-zinc-900 dark:text-white leading-[1.15]">
            {post.title}
          </h1>

          <!-- Subtitle -->
          <p class="mt-4 text-base sm:text-lg font-normal leading-relaxed text-zinc-600 dark:text-zinc-300">
            {post.subtitle}
          </p>

          <!-- Divider -->
          <div class="mt-8 border-b border-zinc-200 dark:border-zinc-800"></div>

          <!-- Author Info Bar -->
          <div class="mt-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img
                src={post.author.avatar}
                alt={post.author.name}
                class="h-10 w-10 rounded-md object-cover border border-zinc-300 dark:border-zinc-700"
              />
              <div>
                <span class="block text-xs font-bold text-zinc-900 dark:text-white">
                  {post.author.name}
                </span>
                <span class="block text-[11px] text-zinc-500 dark:text-zinc-400">
                  {post.author.role}
                </span>
              </div>
            </div>

            <!-- Share Action -->
            <button
              id="copy-link-btn"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-md border border-zinc-300 bg-white px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-zinc-700 shadow-sm transition-all hover:border-[#7C3AED] hover:text-[#7C3AED] dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-300 dark:hover:border-[#7C3AED] dark:hover:text-[#A78BFA]"
            >
              <svg class="h-3.5 w-3.5 text-[#7C3AED]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              <span id="copy-text">Share</span>
            </button>
          </div>
        </header>

        <!-- Featured Banner (Blank Image Space Container) -->
        <div class="my-10 relative overflow-hidden rounded-3xl border border-zinc-200 dark:border-zinc-800/80 aspect-[16/9] sm:aspect-[21/9] bg-zinc-100 dark:bg-[#121215] shadow-inner flex items-end p-5 sm:p-7">
          <!-- Bottom Pill Badges -->
          <div class="flex flex-wrap items-center gap-2 z-10">
            {post.tags.map((tag) => (
              <span class="rounded-full bg-zinc-200/90 dark:bg-zinc-800/90 px-3.5 py-1.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700/60 shadow-sm">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Pull Quote Excerpt -->
        <div class="my-10 border-l-2 border-[#7C3AED] pl-6 py-2">
          <p class="text-base sm:text-lg font-medium leading-relaxed text-zinc-800 dark:text-zinc-200">
            "{post.excerpt}"
          </p>
        </div>

        <!-- Article Sections Body -->
        <div class="space-y-10 my-10">
          {post.sections.map((sec) => (
            <section class="space-y-4">
              {sec.heading && (
                <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white pt-2">
                  {sec.heading}
                </h2>
              )}

              {sec.paragraphs.map((para) => (
                <p class="text-sm sm:text-base leading-relaxed text-zinc-700 dark:text-zinc-300 font-normal">
                  {para}
                </p>
              ))}

              {sec.callout && (
                <div class="my-6 rounded-md border border-zinc-200 bg-zinc-100/70 p-5 dark:border-zinc-800 dark:bg-zinc-900/40">
                  <span class="block text-xs font-bold uppercase tracking-wider text-[#7C3AED] mb-1">
                    ■ KEY TAKEAWAY
                  </span>
                  <p class="text-sm text-zinc-800 dark:text-zinc-200">
                    {sec.callout}
                  </p>
                </div>
              )}

              {sec.listItems && (
                <ul class="my-5 space-y-2.5 pl-1">
                  {sec.listItems.map((item) => (
                    <li class="flex items-start gap-3 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
                      <span class="mt-1.5 h-1.5 w-1.5 flex-none bg-[#7C3AED]" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>

        <!-- Minimalist Author Sign-off Box -->
        <div class="my-12 border-t border-zinc-200 dark:border-zinc-800 pt-8">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
            <div class="flex items-center gap-4">
              <img
                src={post.author.avatar}
                alt={post.author.name}
                class="h-12 w-12 rounded-md object-cover border border-zinc-300 dark:border-zinc-700"
              />
              <div>
                <span class="block text-xs font-extrabold uppercase tracking-wider text-[#7C3AED]">
                  Written By
                </span>
                <span class="block text-base font-bold text-zinc-900 dark:text-white">
                  {post.author.name}
                </span>
                <span class="block text-xs text-zinc-500 dark:text-zinc-400">
                  {post.author.role}
                </span>
              </div>
            </div>

            <a
              href="/#contact"
              class="inline-flex items-center gap-2 rounded-md border border-zinc-300 bg-white px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-900 shadow-sm transition-all hover:border-[#7C3AED] hover:bg-[#7C3AED] hover:text-white dark:border-zinc-800 dark:bg-zinc-950 dark:text-white dark:hover:border-[#7C3AED] dark:hover:bg-[#7C3AED]"
            >
              <span>Get in Touch</span>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Next / Previous Article Navigation -->
        <div class="my-12 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-zinc-200 dark:border-zinc-800 pt-8">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.slug}`}
              class="group flex flex-col justify-between rounded-md border border-zinc-300 dark:border-zinc-800 p-5 hover:border-[#7C3AED] transition-colors bg-white/50 dark:bg-zinc-950/50"
            >
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#7C3AED] flex items-center gap-1.5">
                ← Previous Article
              </span>
              <h4 class="mt-2 text-sm font-bold text-zinc-900 dark:text-white group-hover:text-[#7C3AED] dark:group-hover:text-[#A78BFA] transition-colors line-clamp-2">
                {prevPost.title}
              </h4>
            </a>
          ) : (
            <div />
          )}

          {nextPost && (
            <a
              href={`/blog/${nextPost.slug}`}
              class="group flex flex-col justify-between text-right rounded-md border border-zinc-300 dark:border-zinc-800 p-5 hover:border-[#7C3AED] transition-colors bg-white/50 dark:bg-zinc-950/50"
            >
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#7C3AED] flex items-center justify-end gap-1.5">
                Next Article →
              </span>
              <h4 class="mt-2 text-sm font-bold text-zinc-900 dark:text-white group-hover:text-[#7C3AED] dark:group-hover:text-[#A78BFA] transition-colors line-clamp-2">
                {nextPost.title}
              </h4>
            </a>
          )}
        </div>

      </article>
    </main>

    <!-- Copy Link Toast Script -->
    <script is:inline>
      document.getElementById('copy-link-btn')?.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const textSpan = document.getElementById('copy-text');
        if (textSpan) {
          textSpan.textContent = 'Copied!';
          setTimeout(() => {
            textSpan.textContent = 'Share';
          }, 2000);
        }
      });
    </script>
  </body>
</html>
