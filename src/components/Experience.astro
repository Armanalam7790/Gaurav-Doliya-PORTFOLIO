---
// src/components/Experience.astro

interface ExperienceRole {
  periodLine1: string;
  periodLine2: string;
  role: string;
  company: string;
  location: string;
  achievements: string[];
  tools: string[];
}

const experiences: ExperienceRole[] = [
  {
    periodLine1: "2025 -",
    periodLine2: "PRESENT",
    role: "Graphics & Motion Design Trainer | Academic Head",
    company: "Dice Academy",
    location: "Delhi",
    achievements: [
      "Train students in After Effects, Photoshop and Premiere Pro through practical briefs, critique cycles and portfolio building rather than software walkthroughs alone.",
      "As Academic Head, manage faculty, academic operations, performance assessments and professional-development workshops.",
      "Design practical exams that reward process, iteration and final delivery — a habit that maps directly to IB process portfolios and design journals."
    ],
    tools: [
      "After Effects",
      "Photoshop",
      "Premiere Pro",
      "Illustrator",
      "InDesign",
      "Blender"
    ]
  },
  {
    periodLine1: "2023 -",
    periodLine2: "2025",
    role: "Post-Production Faculty",
    company: "Arena Animation",
    location: "Delhi",
    achievements: [
      "Taught editing, motion graphics and compositing with differentiated briefs for mixed-ability groups.",
      "Assessed work through regular reviews and gave specific, production-oriented feedback students could act on in the next cut."
    ],
    tools: [
      "After Effects",
      "Premiere Pro",
      "DaVinci Resolve",
      "Photoshop"
    ]
  },
  {
    periodLine1: "2019 -",
    periodLine2: "2023",
    role: "Post-Production Trainer",
    company: "MAAC",
    location: "New Delhi",
    achievements: [
      "Built project pipelines using specialised post-production tools and tailored resources for varied learner needs.",
      "Mentored students who later worked with production and brand teams including MPL, Astrophysics, Portronics, MPC and Hammer."
    ],
    tools: [
      "After Effects",
      "Premiere Pro",
      "Photoshop",
      "DaVinci Resolve"
    ]
  },
  {
    periodLine1: "2019",
    periodLine2: "",
    role: "Junior Compositor",
    company: "ZIMA Digitals",
    location: "Mumbai",
    achievements: [
      "Integrated CGI with live-action footage in a commercial studio pipeline, strengthening the industry practice I now teach."
    ],
    tools: [
      "After Effects",
      "Photoshop",
      "Blender"
    ]
  }
];
---

<section id="experience" class="scroll-mt-16 relative bg-[#F5F5F5] text-zinc-900 dark:bg-black dark:text-white pt-12 sm:pt-20 pb-12 sm:pb-28 transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-6 sm:px-8">
    
    <!-- Top Header Area Matching Hand-drawn Sketch -->
    <div class="pb-6 sm:pb-8">
      <h2 class="flex flex-wrap items-baseline gap-x-5 sm:gap-x-7 lg:gap-x-9 text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-wider text-zinc-900 dark:text-white font-['Anton',sans-serif] transition-colors duration-200">
        <span>WORK</span>
        <span>EXPERIENCE</span>
      </h2>
      <p class="mt-4 max-w-3xl text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-300 font-normal transition-colors duration-200">
        Motion design and post-production educator with seven years of studio-style teaching and academic leadership. I take students from brief to finished film, motion graphic or composite through iterative critique, process documentation and portfolio reviews.
      </p>
    </div>

    <!-- Full-Width Horizontal Line Divider from Sketch -->
    <div class="border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-200"></div>

    <!-- Experience Items List -->
    <div class="divide-y divide-zinc-200 dark:divide-zinc-800/80 transition-colors duration-200">
      {experiences.map((exp) => (
        <div class="py-8 sm:py-14 last:pb-0">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14">
            
            <!-- Left Column: Dates stacked like sketch (AUG 2025 - / PRESENT) -->
            <div class="lg:col-span-3 flex lg:flex-col items-baseline lg:items-start justify-between lg:justify-start gap-1">
              <div>
                <span class="block text-sm sm:text-base font-extrabold uppercase tracking-wider text-[#7C3AED]">
                  {exp.periodLine1}
                </span>
                <span class="block text-sm sm:text-base font-extrabold uppercase tracking-wider text-[#7C3AED]">
                  {exp.periodLine2}
                </span>
              </div>
              <div class="hidden lg:block mt-4 h-2 w-2 bg-[#7C3AED]"></div>
            </div>

            <!-- Right Column: Role Title, Company, 2x2 Grid of Achievements, Tool Chips -->
            <div class="lg:col-span-9">
              <!-- Role Header -->
              <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white transition-colors duration-200">
                {exp.role}
              </h3>
              <p class="mt-1 text-xs sm:text-sm font-medium">
                <span class="text-zinc-800 dark:text-zinc-200 font-semibold">{exp.company}</span>
                <span class="text-[#7C3AED] dark:text-[#7C3AED] font-semibold"> • {exp.location}</span>
              </p>

              <!-- 2x2 Grid of Achievements with Square Accent Bullets -->
              <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
                {exp.achievements.map((point) => (
                  <div class="flex items-start gap-3">
                    <span class="mt-2 h-1.5 w-1.5 flex-none bg-[#7C3AED]"></span>
                    <p class="text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-300 transition-colors duration-200">
                      {point}
                    </p>
                  </div>
                ))}
              </div>

              <!-- Tools / Software Badges Row (as drawn in boxes in the sketch) -->
              <div class="mt-8 flex flex-wrap gap-2.5">
                {exp.tools.map((tool) => (
                  <span class="rounded-md border border-zinc-300 bg-zinc-100 px-3.5 py-1.5 text-xs font-semibold text-zinc-800 shadow-sm transition-all hover:border-[#7C3AED] hover:bg-zinc-200 hover:text-[#7C3AED] dark:border-zinc-800 dark:bg-zinc-900/90 dark:text-zinc-300 dark:hover:border-[#7C3AED] dark:hover:bg-zinc-800 dark:hover:text-white">
                    {tool}
                  </span>
                ))}
              </div>

            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>
