---
// src/components/Blogs.astro
import { blogs } from "../data/blogs";

// Display the first 3 featured blogs on the homepage
const featuredBlogs = blogs.slice(0, 3);
---

<section
  id="blogs"
  class="scroll-mt-16 relative bg-[#F5F5F5] text-zinc-900 dark:bg-black dark:text-white pt-10 sm:pt-20 pb-14 sm:pb-32 transition-colors duration-200"
>
  <div class="mx-auto max-w-7xl px-6 sm:px-8">
    
    <!-- Top Header Area Matching Portfolio Identity -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 sm:pb-8">
      <div>
        <h2
          class="flex flex-wrap items-baseline gap-x-5 sm:gap-x-7 lg:gap-x-9 text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-wider text-zinc-900 dark:text-white font-['Anton',sans-serif] transition-colors duration-200"
        >
          <span>ARTICLES &</span>
          <span>WRITING</span>
        </h2>
        <p
          class="mt-4 max-w-2xl text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-400 font-normal transition-colors duration-200"
        >
          Thoughts, industry breakdowns, and practical workflows on 3D motion design, typography, and visual craft.
        </p>
      </div>

      <!-- Link to the dedicated blogs page -->
      <a
        href="/blogs"
        class="group inline-flex items-center gap-2 self-start sm:self-end rounded-full border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900/80 px-5 py-2.5 text-xs font-semibold text-zinc-900 dark:text-white shadow-sm transition-all hover:border-[#7C3AED] hover:bg-[#7C3AED] hover:text-white dark:hover:border-[#7C3AED] dark:hover:bg-[#7C3AED]"
      >
        <span>View All Articles ({blogs.length})</span>
        <svg
          class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <!-- Full-Width Horizontal Line Divider -->
    <div class="border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-200 mb-8 sm:mb-12"></div>

    <!-- Clean Modern Cards Grid (Clickable, Blank Image Container) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 lg:gap-8">
      {
        featuredBlogs.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col overflow-hidden rounded-[26px] border border-zinc-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl dark:border-zinc-800/90 dark:bg-[#121215] dark:hover:border-[#7C3AED]/50"
          >
            <!-- Blank Image Placeholder Area -->
            <div class="relative aspect-[16/10] w-full bg-zinc-100 dark:bg-zinc-900/60 border-b border-zinc-200 dark:border-zinc-800/80 transition-colors"></div>

            <!-- Card Body -->
            <div class="p-6 flex flex-col flex-1 justify-between">
              <div>
                <!-- Title -->
                <h3 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-white leading-snug group-hover:text-[#7C3AED] dark:group-hover:text-[#A78BFA] transition-colors">
                  {post.title}
                </h3>

                <!-- Excerpt -->
                <p class="mt-2.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 line-clamp-2">
                  {post.excerpt}
                </p>
              </div>

              <!-- Divider & Footer Row -->
              <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
                <!-- Author & Date -->
                <div class="flex items-center gap-3">
                  <img
                    src={post.author.avatar}
                    alt={post.author.name}
                    class="h-9 w-9 rounded-full object-cover ring-2 ring-zinc-200 dark:ring-zinc-800"
                  />
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-zinc-900 dark:text-white leading-tight">
                      {post.author.name}
                    </span>
                    <span class="text-xs text-zinc-500 dark:text-zinc-400 leading-tight mt-0.5">
                      {post.date}
                    </span>
                  </div>
                </div>

                <!-- Reading Time with Clock Icon -->
                <div class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400 font-medium">
                  <svg class="h-3.5 w-3.5 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3" />
                  </svg>
                  <span>{post.readTime}</span>
                </div>
              </div>

            </div>
          </a>
        ))
      }
    </div>



  </div>
</section>
