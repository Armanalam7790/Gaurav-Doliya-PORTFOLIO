---
// src/components/Blogs.astro
import { blogs } from "../data/blogs";
---

<section
  id="blogs"
  class="scroll-mt-16 relative bg-[#F5F5F5] text-zinc-900 dark:bg-black dark:text-white pt-10 sm:pt-20 pb-14 sm:pb-32 transition-colors duration-200"
>
  <div class="mx-auto max-w-7xl px-6 sm:px-8">
    
    <!-- Top Header Area Matching Portfolio Identity -->
    <div class="pb-6 sm:pb-8">
      <div>
        <h2
          class="flex flex-wrap items-baseline gap-x-5 sm:gap-x-7 lg:gap-x-9 text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-wider text-zinc-900 dark:text-white font-['Anton',sans-serif] transition-colors duration-200"
        >
          <span>ARTICLES &</span>
          <span>WRITING</span>
        </h2>
        <p
          class="mt-4 max-w-3xl text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-400 font-normal transition-colors duration-200"
        >
          Thoughts, industry breakdowns, and practical workflows on 3D motion design, typography, and visual craft.
        </p>
      </div>
    </div>

    <!-- Full-Width Horizontal Line Divider -->
    <div class="border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-200 mb-8 sm:mb-12"></div>

    <!-- Clean Modern Cards Grid (Non-Clickable Showcase) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 lg:gap-8">
      {
        blogs.map((post) => (
          <article class="group flex flex-col overflow-hidden rounded-[26px] border border-zinc-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl dark:border-zinc-800/90 dark:bg-[#121215] dark:hover:border-zinc-700 select-none">
            
            <!-- Cover Banner with Overlay Pill Tags -->
            <div class="relative aspect-[16/10] w-full overflow-hidden block">
              <img
                src={post.coverImage}
                alt={post.title}
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
              <!-- Dark gradient overlay for badge readability -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>

              <!-- Pill Tags in Bottom-Left of Image -->
              <div class="absolute bottom-3.5 left-4 flex flex-wrap items-center gap-2 z-10">
                {post.tags.slice(0, 2).map((tag) => (
                  <span class="rounded-full bg-black/60 backdrop-blur-md px-3.5 py-1 text-xs font-medium text-white border border-white/20 shadow-sm">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-6 flex flex-col flex-1 justify-between">
              <div>
                <!-- Title (Non-clickable) -->
                <h3 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-white leading-snug">
                  {post.title}
                </h3>

                <!-- Excerpt -->
                <p class="mt-2.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 line-clamp-2">
                  {post.excerpt}
                </p>
              </div>

              <!-- Divider & Footer Row -->
              <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
                <!-- Author & Date -->
                <div class="flex items-center gap-3">
                  <img
                    src={post.author.avatar}
                    alt={post.author.name}
                    class="h-9 w-9 rounded-full object-cover ring-2 ring-zinc-200 dark:ring-zinc-800"
                  />
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-zinc-900 dark:text-white leading-tight">
                      {post.author.name}
                    </span>
                    <span class="text-xs text-zinc-500 dark:text-zinc-400 leading-tight mt-0.5">
                      {post.date}
                    </span>
                  </div>
                </div>

                <!-- Reading Time with Clock Icon -->
                <div class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400 font-medium">
                  <svg class="h-3.5 w-3.5 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3" />
                  </svg>
                  <span>{post.readTime}</span>
                </div>
              </div>

            </div>

          </article>
        ))
      }
    </div>

  </div>
</section>
