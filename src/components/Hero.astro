---
// src/components/Hero.astro
---

<section
  id="home"
  class="relative isolate min-h-[calc(100svh-4rem)] scroll-mt-24 overflow-hidden pt-20 pb-20 sm:pt-28 md:pt-36 lg:pt-40 md:pb-32 bg-[#FAF6F3] text-zinc-900 dark:bg-[#0c0706] dark:text-white transition-colors duration-300"
>
  <!-- Fluid Canvas Gradient matching rishikeshs.net -->
  <canvas
    id="hero-canvas"
    class="pointer-events-none absolute inset-0 h-full w-full"
    aria-hidden="true"
  ></canvas>

  <!-- Hero Scrim with silky backdrop blur for organic fluid mesh look -->
  <div class="hero-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <!-- Soft bottom vignette to blend smoothly into Experience section -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-[#F5F5F5] dark:to-black"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 sm:px-8">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
      <!-- Left Column: Intro Details -->
      <div
        class="flex flex-col items-start lg:col-span-7 -mt-8 sm:-mt-12 md:-mt-16 lg:-mt-12"
      >
        <!-- Role Tag with coral square (matching reference) -->
        <div class="flex items-center gap-2.5">
          <div class="h-3.5 w-3.5 rounded-[3px] bg-[#de4528] flex-none"></div>
          <span class="text-xs font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-400">
            Visual Arts &amp; Digital Media Educator
          </span>
        </div>

        <!-- Main Title (GAURAV DOLIYA) -->
        <h1
          class="mt-4 text-4xl font-black uppercase tracking-tight text-zinc-950 dark:text-white sm:text-6xl lg:text-7xl transition-colors duration-200"
        >
          GAURAV DOLIYA
        </h1>

        <!-- Subtitle -->
        <p class="mt-2 text-sm font-semibold tracking-wide text-zinc-500 dark:text-zinc-400">
          Motion Design &nbsp;·&nbsp; Post-Production &nbsp;·&nbsp; 3D LookDev
        </p>

        <p
          class="mt-4 max-w-2xl text-base sm:text-lg font-normal leading-relaxed text-zinc-700 dark:text-zinc-300 transition-colors duration-200"
        >
          Motion design and post-production educator with seven years of
          studio-style teaching and academic leadership. I take students from
          brief to finished film, motion graphic or composite through iterative
          critique, process documentation and portfolio reviews.
        </p>

        <!-- Action Buttons (View Resume, Email, LinkedIn) -->
        <div class="mt-8 flex flex-wrap items-center gap-3.5 sm:gap-4">
          <!-- View Resume (Solid coral button like reference) -->
          <a
            href="/Gaurav_Doliya_CV_OCT_2026.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-lg bg-[#de4528] px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-md shadow-[#de4528]/25 transition-all hover:bg-[#c6391e] active:scale-95"
          >
            <span>View Resume</span>
            <svg
              class="h-4 w-4 text-white/80 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>

          <!-- Email -->
          <a
            href="mailto:gauravdoliya.fxwork@gmail.com"
            class="group inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white/80 backdrop-blur-md px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-zinc-800 shadow-sm transition-all hover:border-zinc-400 hover:bg-white active:scale-95 dark:border-zinc-800 dark:bg-black/50 dark:text-zinc-200 dark:hover:border-zinc-600 dark:hover:bg-black/70 dark:hover:text-white"
          >
            <svg
              class="h-4 w-4 text-zinc-500 transition-colors group-hover:text-zinc-900 dark:text-zinc-400 dark:group-hover:text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>Email</span>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/gauravdoliya"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white/80 backdrop-blur-md px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-zinc-800 shadow-sm transition-all hover:border-zinc-400 hover:bg-white active:scale-95 dark:border-zinc-800 dark:bg-black/50 dark:text-zinc-200 dark:hover:border-zinc-600 dark:hover:bg-black/70 dark:hover:text-white"
          >
            <svg
              class="h-4 w-4 text-zinc-500 transition-colors group-hover:text-zinc-900 dark:text-zinc-400 dark:group-hover:text-white"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Exact Reference Composition (Wireframe Outline + Solid Block + Monochrome Portrait) -->
      <div
        class="flex justify-center lg:col-span-5 lg:justify-end lg:-mt-12 mr-0 sm:mr-2 md:mr-4 lg:mr-6"
      >
        <div
          class="group relative mt-6 mb-10 sm:mt-8 sm:mb-12 lg:mt-4 lg:mb-6 w-64 sm:w-72 md:w-[340px] lg:w-[370px] xl:w-[390px] aspect-square"
        >
          <!-- Element 1: Top-Left Thin Wireframe Outline Box (as in reference image) -->
          <div
            class="pointer-events-none absolute -top-6 -left-6 sm:-top-7 sm:-left-7 md:-top-8 md:-left-8 h-full w-full border border-zinc-400 dark:border-zinc-500/60 transition-transform duration-500 ease-out group-hover:-translate-x-2 group-hover:-translate-y-2"
          >
          </div>

          <!-- Element 2: Bottom-Right Solid Accent Block (matching reference coral-red) -->
          <div
            class="pointer-events-none absolute -bottom-6 -right-6 sm:-bottom-7 sm:-right-7 md:-bottom-8 md:-right-8 h-full w-full bg-[#de4528] border-2 border-[#ea5a3d]/80 transition-transform duration-500 ease-out group-hover:translate-x-2 group-hover:translate-y-2 shadow-2xl"
          >
          </div>

          <!-- Element 3: Center Foreground Monochrome Portrait -->
          <div
            class="relative z-10 h-full w-full overflow-hidden bg-white dark:bg-black border border-zinc-300 dark:border-zinc-800 shadow-2xl transition-all duration-500 group-hover:border-zinc-400 dark:group-hover:border-zinc-600"
          >
            <img
              src="/img.jpg"
              alt="Gaurav Doliya"
              class="h-full w-full object-cover contrast-110 brightness-105 transition-transform duration-700 ease-out group-hover:scale-105"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-scrim {
    backdrop-filter: blur(26px);
    -webkit-backdrop-filter: blur(26px);
  }
</style>

<script is:inline>
  (function () {
    const canvas = document.getElementById('hero-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animId = null;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    let startTime = performance.now();

    function render(now) {
      const elapsed = now - startTime;
      const isDark = document.documentElement.classList.contains('dark');

      // Base canvas color (Creamy white in light mode, deep dark in dark mode)
      ctx.fillStyle = isDark ? '#0c0706' : '#FFF9F6';
      ctx.fillRect(0, 0, width, height);

      // Alternating '<' curved chevron bands
      const bend = width * 0.32;      // Crisp, pronounced '<' bend to the left
      const spacing = width * 0.24;   // Distance between bands
      const lineWidth = width * 0.125; // Width of red bands
      const drift = (elapsed * 0.012) % spacing;

      ctx.lineWidth = lineWidth;
      ctx.lineCap = 'round';

      // Repeating chevron bands across the width
      for (let i = -1; i <= 6; i++) {
        const x0 = i * spacing - drift + width * 0.18;
        const wobble = Math.sin(elapsed * 0.0005 + i * 1.1) * (width * 0.012);
        const apexY = height * 0.48 + Math.cos(elapsed * 0.0004 + i) * (height * 0.015);

        // Vibrant coral-red matching reference screenshot
        const alpha = isDark ? 0.70 : 0.90;
        const color = isDark
          ? `rgba(${226 + (i % 2) * 15}, ${70 + (i % 2) * 15}, 38, ${alpha})`
          : `rgba(${240 + (i % 2) * 10}, ${78 + (i % 2) * 18}, 48, ${alpha})`;

        ctx.strokeStyle = color;
        ctx.beginPath();
        // Starts at top right
        ctx.moveTo(x0, -40);
        // Curves towards the left '<' at apexY
        ctx.quadraticCurveTo(x0 - bend + wobble, apexY, x0, height + 40);
        ctx.stroke();
      }

      animId = requestAnimationFrame(render);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // IntersectionObserver to only animate when visible
    const section = document.getElementById('home');
    if (section && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (!animId) {
                startTime = performance.now();
                animId = requestAnimationFrame(render);
              }
            } else {
              if (animId) {
                cancelAnimationFrame(animId);
                animId = null;
              }
            }
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(section);
    } else {
      animId = requestAnimationFrame(render);
    }
  })();
</script>
