---
// src/components/Contact.astro
---

<section
  id="contact"
  class="scroll-mt-16 relative bg-[#F5F5F5] text-zinc-900 dark:bg-black dark:text-white pt-10 sm:pt-16 pb-14 sm:pb-24 transition-colors duration-200"
>
  <div class="mx-auto max-w-7xl px-6 sm:px-8">
    <!-- Clean Minimalist Header -->
    <div class="pb-6 sm:pb-8">
      <h2
        class="flex flex-wrap items-baseline gap-x-4 sm:gap-x-6 text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-wider text-zinc-900 dark:text-white font-['Anton',sans-serif] transition-colors duration-200"
      >
        <span>LET'S</span>
        <span>Connect</span>
      </h2>
      
    </div>

    <!-- Full-Width Horizontal Line Divider -->
    <div
      class="border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-200 mb-10 sm:mb-14"
    >
    </div>

    <!-- Direct Contact Details Grid -->
    <div class="max-w-3xl mx-auto w-full my-4 sm:my-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 sm:gap-4">
        <!-- Phone / WhatsApp -->
        <a
          href="https://wa.me/918383043341"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col gap-1.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] p-4 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-md transition-all group"
        >
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">WhatsApp / Phone</span>
            <div class="h-6 w-6 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-700 dark:text-zinc-300">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
          </div>
          <span class="font-bold text-sm text-zinc-900 dark:text-white transition-colors mt-1">
            +91 83830 43341
          </span>
          <span class="text-[11px] text-zinc-500">Chat on WhatsApp</span>
        </a>

        <!-- Email -->
        <a
          href="https://mail.google.com/mail/?view=cm&fs=1&to=gauravdoliya.fxwork@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col gap-1.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] p-4 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-md transition-all group"
        >
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Email</span>
            <div class="h-6 w-6 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-700 dark:text-zinc-300">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
          </div>
          <span class="font-bold text-xs sm:text-[13px] text-zinc-900 dark:text-white transition-colors truncate mt-1">
            gauravdoliya.fxwork@gmail.com
          </span>
          <span class="text-[11px] text-zinc-500">Send an email</span>
        </a>

        <!-- Location (Non-clickable, informational with hover effect) -->
        <div
          class="flex flex-col gap-1.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] p-4 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-md transition-all group cursor-default"
        >
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Location</span>
            <div class="h-6 w-6 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-700 dark:text-zinc-300">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
          </div>
          <span class="font-bold text-sm text-zinc-900 dark:text-white transition-colors mt-1">
            New Delhi, India
          </span>
          <span class="text-[11px] text-zinc-500">IST (UTC +5:30)</span>
        </div>
      </div>
    </div>

    <!-- Minimalist Footer -->
    <div
      class="mt-14 sm:mt-24 border-t border-zinc-200 dark:border-zinc-800/80 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 dark:text-zinc-400"
    >
      <div
        class="flex items-center gap-2 font-bold text-zinc-900 dark:text-white"
      >
        <span>Gaurav Doliya</span>
        <span class="text-accent">.</span>
        <span class="font-normal text-zinc-400">© 2026</span>
      </div>

      <div class="flex items-center gap-6 text-xs">
        <a href="#home" class="hover:text-accent transition-colors">Top ↑</a>
        <a href="#experience" class="hover:text-accent transition-colors"
          >Experience</a
        >
        <a href="/blogs" class="hover:text-accent transition-colors">Blogs</a>
        <a href="#projects" class="hover:text-accent transition-colors">Projects</a>
      </div>
    </div>
  </div>
</section>
